{
  "wurk": 1,

  "beads": {
    "prefix": "uxrs",
    "sync": "dolthub",
    "topology": "beads",
    "areas": {
      "labels": [
        "area:codec",
        "area:monotonic",
        "area:conformance",
        "area:docs",
        "area:build"
      ],
      "lands_alone": ["area:build"],
      "always_batchable": ["upstream"]
    }
  },

  "forge": {
    "kind": "github",
    "labels": {}
  },

  "gate": {
    "full": ["mise", "run", "gate"],
    "loop": ["mise", "run", "gate:loop"],
    "build_paths": [
      "src/",
      "tests/",
      "examples/",
      "benches/",
      "build.rs",
      ".cargo/",
      "Cargo.toml",
      "Cargo.lock",
      "mise.toml",
      "deny.toml",
      "rustfmt.toml",
      "clippy.toml"
    ],
    "also_gated_paths": ["conformance/"],
    "moving_files": ["mise.toml", "deny.toml", "rustfmt.toml", "clippy.toml"],
    "sabotage": {
      "test_roots": ["tests/", "src/"],
      "test_pattern": "#\\[test\\]",
      "exempt_prefixes": []
    },
    "project_level_skips": [],
    "not_applicable_skips": []
  },

  "parallelism": {
    "model": "worktree-per-issue",
    "worktrees_dir": "../uxid-rs-worktrees",
    "trust": ["mise", "trust", "{path}"],
    "warm_clone": [],
    "warm": [["mise", "exec", "--", "cargo", "fetch"]],
    "repair_when": "Cargo.lock",
    "repair": [["mise", "exec", "--", "cargo", "fetch"]],
    "post_branch": []
  },

  "tmux": {
    "session": "uxid-rs",
    "model": "opus"
  },

  "models": {
    "direction": "fable"
  },

  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research",
    "filename": "YYMMDD-[id-]kebab"
  },

  "commits": {
    "style": "s-form",
    "subject_under": 72,
    "body_line_max": 72,
    "total_lines_max": 40,
    "trailer": {
      "key": "Refs"
    }
  },

  "changelog": {
    "mode": "fragments",
    "dir": "changelog.d"
  },

  "release": {
    "kind": "cargo",
    "version_file": "Cargo.toml"
  }
}
